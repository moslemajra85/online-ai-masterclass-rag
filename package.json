{
  "name": "rag-journey-workshop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-workshop-assets.mjs && vinext dev --port 3001",
    "build": "node scripts/prepare-workshop-assets.mjs && vinext build && node scripts/prepare-sites-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "vinext lint",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.3",
    "@xyflow/react": "^12.11.2",
    "gsap": "^3.15.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.3"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.2"
  }
}
